+#[cfg(test)]
+mod rv_merge_gap_tests {
+    use super::*;
+    fn sample(gap: f64) -> Loop2 {
+        let mut lp = Loop2::polygon(&[Vec2::new(0., 0.), Vec2::new(20., 0.), Vec2::new(20., 20.), Vec2::new(0., 20.)]);
+        lp.segs[0] = Seg2::Line { a: Vec2::new(0., 0.), b: Vec2::new(20. + gap, 0.) };
+        lp
+    }
+    #[test]
+    fn welds_only_existing_union_tolerance() {
+        let mut lp = sample(4e-6);
+        assert!(!lp.is_closed(1e-6));
+        close_linear_merge_gaps(&mut lp).unwrap();
+        assert!(lp.is_closed(1e-12));
+        assert!((lp.signed_area() - 400.).abs() < 1e-4);
+    }
+    #[test]
+    fn rejects_real_gap_without_mutation() {
+        let mut lp = sample(2e-5);
+        let before = lp.clone();
+        assert!(close_linear_merge_gaps(&mut lp).is_err());
+        assert_eq!(lp, before);
+    }
+}
