+/// Region union joins vertices within 10 * MERGE_TOL. Its line segments can
+/// retain their pre-merge endpoints, leaving micron gaps rejected by the B-rep
+/// builder (1 * MERGE_TOL). Weld only linear loops within that existing union
+/// tolerance; never bridge an actual open contour or approximate analytic arcs.
+fn close_linear_merge_gaps(lp: &mut Loop2) -> Result<()> {
+    if lp.is_closed(MERGE_TOL) || !lp.segs.iter().all(|s| matches!(s, Seg2::Line { .. })) {
+        return Ok(());
+    }
+    let n = lp.segs.len();
+    if n < 3 {
+        return Err(bad("thin wall has a degenerate boundary"));
+    }
+    let mut joints = Vec::with_capacity(n);
+    for i in 0..n {
+        let previous = lp.segs.get((i + n - 1) % n).ok_or_else(|| bad("wall boundary"))?;
+        let current = lp.segs.get(i).ok_or_else(|| bad("wall boundary"))?;
+        let (a, b) = (previous.end(), current.start());
+        if a.dist(b) > MERGE_TOL * 10.0 + 1e-12 {
+            return Err(bad("thin wall boundary has a gap beyond merge tolerance"));
+        }
+        joints.push((a + b) * 0.5);
+    }
+    let rebuilt = Loop2::polygon(&joints);
+    if rebuilt.segs.iter().any(|s| s.length() <= 1e-9)
+        || rebuilt.signed_area() * lp.signed_area() <= 0.0
+    {
+        return Err(bad("thin wall boundary collapsed during vertex merge"));
+    }
+    *lp = rebuilt;
+    Ok(())
 }
 
